@model ClienteModel
@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<h2>@ViewData["Title"]</h2>

<partial name="_Formulario" model="Model" view-data='new ViewDataDictionary(ViewData) { { "UrlPost", Url.Action("Incluir", "Cliente") } }' />

@section Scripts {
    <script src="~/lib/imask/imask.min.js"></script>
    <script type="module" src="~/js/cliente-form.js" asp-append-version="true"></script>
}
