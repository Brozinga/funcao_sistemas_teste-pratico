@model ClienteModel

<form id="formCadastro" novalidate
      data-url-post="@ViewData["UrlPost"]"
      data-url-retorno="@ViewData["UrlRetorno"]"
      data-id="@Model.Id">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Nome" class="form-label">Nome:</label>
            <input asp-for="Nome" class="form-control" placeholder="Ex.: João" maxlength="50" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Sobrenome" class="form-label">Sobrenome:</label>
            <input asp-for="Sobrenome" class="form-control" placeholder="Ex.: da Silva" maxlength="255" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Cpf" class="form-label">CPF:</label>
            <input asp-for="Cpf" class="form-control" placeholder="Ex.: 010.011.111-00" maxlength="14" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Nacionalidade" class="form-label">Nacionalidade:</label>
            <input asp-for="Nacionalidade" class="form-control" placeholder="Ex.: brasileira" maxlength="50" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Cep" class="form-label">CEP:</label>
            <input asp-for="Cep" class="form-control" placeholder="Ex.: 01011-100" maxlength="9" required />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Estado" class="form-label">Estado:</label>
            <select asp-for="Estado" class="form-select" required>
                <option value="">Selecione</option>
                <option value="SP">São Paulo</option>
                <option value="PE">Pernambuco</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Cidade" class="form-label">Cidade:</label>
            <input asp-for="Cidade" class="form-control" placeholder="Ex.: São Paulo" maxlength="50" required />
        </div>
    </div>
    <div class="row">
        <div class="col-12 mb-3">
            <label asp-for="Logradouro" class="form-label">Logradouro:</label>
            <input asp-for="Logradouro" class="form-control" placeholder="Ex.: Rua Boa Vista 253" maxlength="500" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Email" class="form-label">E-mail:</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="Ex.: email@email.com" maxlength="2079" required />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Telefone" class="form-label">Telefone:</label>
            <input asp-for="Telefone" type="tel" class="form-control" placeholder="Ex.: (11) 2020-3030" maxlength="15" required />
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <button type="button" id="btnBeneficiarios" class="btn btn-sm btn-primary">Beneficiários</button>
        <div>
            <button type="submit" class="btn btn-sm btn-success">Salvar</button>
            <a class="btn btn-sm btn-danger" asp-action="Index">Voltar</a>
        </div>
    </div>
</form>

<div class="modal fade" id="modalBeneficiarios" tabindex="-1" aria-labelledby="tituloBeneficiarios" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tituloBeneficiarios">Beneficiários</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <form id="formBeneficiario" novalidate>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="BenefCpf" class="form-label">CPF:</label>
                            <input type="text" class="form-control" id="BenefCpf" name="BenefCpf" placeholder="Ex.: 010.011.111-00" maxlength="14" required />
                        </div>
                        <div class="col-md-5 mb-3">
                            <label for="BenefNome" class="form-label">Nome:</label>
                            <input type="text" class="form-control" id="BenefNome" name="BenefNome" placeholder="Ex.: Maria" maxlength="50" minlength="3" required />
                        </div>
                        <div class="col-md-3 mb-3 align-self-md-end">
                            <button type="submit" id="btnIncluirBenef" class="btn btn-sm btn-success w-100">Incluir</button>
                        </div>
                    </div>
                </form>

                <table id="gridBeneficiarios" class="table">
                    <thead>
                        <tr>
                            <th>CPF</th>
                            <th>Nome</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="dadosBeneficiarios">@Html.Raw(Json.Serialize(Model.Beneficiarios))</script>
